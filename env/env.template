# ============================================================
# release-tests-infra — environment configuration
# ============================================================
#
# Setup:
#   cp env.template .env
#   source .env
# ============================================================

# --- Cluster connection ---
# For Cluster Platforms
# INSTALLER=cluster-platforms  (required: APISERVER, OC_TOKEN, CLUSTER_CA_CERT)
# CLUSTER_NAME=
# APISERVER=
# OC_TOKEN=
# CLUSTER_CA_CERT=
# KUBEADMIN_PASSWORD=
# KUBEADMIN_USER=kubeadmin
# USER_PASSWORD=

# Any other clusters
# INSTALLER=none  (required: APISERVER, KUBEADMIN_PASSWORD)
# CLUSTER_NAME=
# APISERVER=
# KUBEADMIN_PASSWORD=
# KUBEADMIN_USER=kubeadmin
# USER_PASSWORD=

# AWS IPI provisioning (provisions a new cluster, destroys after tests)
# INSTALLER=aws-ipi
# CLUSTER_NAME=upgrd
# BASE_DOMAIN=aws.ospqa.com
# AWS_REGION=us-east-2
# OPENSHIFT_VERSION=stable-4.19
# KEEP_CLUSTER=false
# CLUSTER_LIFETIME=6h
# PULL_SECRET=              # JSON pull secret from console.redhat.com
# SSH_PUBLIC_KEY=            # SSH public key for node access

# ARO provisioning (Azure Red Hat OpenShift)
# INSTALLER=aro
# CLUSTER_NAME=aro
# OPENSHIFT_VERSION=4.15    # must match az aro get-versions (specific version, not 'stable')
# AZURE_LOCATION=eastus
# KEEP_CLUSTER=false
# AZURE_TENANT=             # from Vault if empty
# AZURE_USERNAME=            # from Vault if empty
# AZURE_PASSWORD=            # from Vault if empty

# Flexy provisioning (disconnected / custom templates via ITUP cluster)
# INSTALLER=flexy
# CLUSTER_NAME=air
# OPENSHIFT_VERSION=stable-4.19
# KEEP_CLUSTER=true
# CLUSTER_LIFETIME=48h
# TEMPLATE=private-templates/functionality-testing/aos-4_19/ipi-on-aws/versioned-installer-customer_vpc-disconnected
# LAUNCHER_VARS={"dynamic_bastion_host":"yes"}
# GIT_PRIVATE_TEMPLATES_BRANCH=master
# GIT_PRIVATE_TEMPLATES_URI=https://gitlab.cee.redhat.com/aosqe/flexy-templates.git

# --- Upgrade tests (scripts/run-upgrade-tests.sh) ---
# PRE_UPGRADE_VERSION=1.21.2
# PRE_UPGRADE_OPERATOR_ENVIRONMENT=prod
# PRE_UPGRADE_CATALOG_SOURCE=redhat-operators
# PRE_UPGRADE_KONFLUX_INDEX_IMAGE=
# PRE_UPGRADE_CHANNEL=
# UPGRADE_VERSION=1.22.2
# UPGRADE_OPERATOR_ENVIRONMENT=pre-stage
# UPGRADE_CATALOG_SOURCE=custom-operators
# UPGRADE_KONFLUX_INDEX_IMAGE=
# UPGRADE_CHANNEL=

# --- Operator configuration ---
# CHANNEL and git branches are auto-resolved from ci-config.yaml using
# OPERATOR_VERSION when left empty or set to "latest".
# Explicit values here always override ci-config.yaml defaults.
ARCH=
CATALOG_SOURCE=
CHANNEL=
OPERATOR_VERSION=
OPERATOR_ENVIRONMENT=
KONFLUX_INDEX_IMAGE=
INSTALL_PIPELINES_OPERATOR=
INSTALL_LOGGING_OPERATOR=
INSTALL_SERVERLESS_OPERATOR=
UNINSTALL_PIPELINES_OPERATOR=
IS_DISCONNECTED=false
TAGS=
TEST_SUITES=
SEND_SLACK_NOTIFICATION=

# Test framework and git branches (auto-resolved from ci-config.yaml if empty)
TEST_FRAMEWORK=gauge
GIT_RELEASE_TESTS_BRANCH=
# TEST_FRAMEWORK=ginkgo
# GIT_RELEASE_TESTS_GINKGO_BRANCH=

# release-tests-infra branch
GIT_INFRA_BRANCH=

# ============================================================
# TEST PROFILES — uncomment ONE section to set operator config,
# test suites, and tags for a specific environment.
# These override the values above.
# ============================================================

