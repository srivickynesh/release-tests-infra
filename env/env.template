# --- Container image for test runner ---
IMAGE=

# --- TKN CLI download URL ---
TKN_DOWNLOAD_URL=https://developers.redhat.com/content-gateway/file/pub/cgw/pipelines/1.22.0/tkn-linux-amd64.tar.gz

# --- Secret credential source (Vault)---
# VAULT_TOKEN=
# VAULT_ADDR=
# VAULT_KV_MOUNT=
# VAULT_KV_PATH=

# --- Secret credential source (local) ---
# local = non-empty vars below | vault = OIDC login + Vault KV (./scripts/create-secrets.sh --vault-login)
CRED_SOURCE=local

# --- GitHub (PAC) — PAC_GITHUB_TOKEN can come from Vault GITHUB_TOKEN; PAC_GITHUB_ORG must be set here ---
GITHUB_TOKEN=
PAC_GITHUB_TOKEN=
PAC_GITHUB_ORG=
PAC_GITHUB_WEBHOOK_TOKEN=

# --- GitLab (PAC) ---
GITLAB_TOKEN=
GITLAB_GROUP_NAMESPACE=
GITLAB_PROJECT_ID=
GITLAB_WEBHOOK_TOKEN=

# --- Quay ---
QUAY_USER=
QUAY_PASS=
QUAY_API_TOKEN=

# --- Brew (brew.registry.redhat.io — pre-stage/stage IIB images) ---
BREW_USER=
BREW_PASS=

# --- Stage registry (registry.stage.redhat.io — stage operator bundles) ---
# Create at https://access.stage.redhat.com/terms-based-registry/
# Or use your Red Hat SSO credentials
STAGE_REGISTRY_USER=
STAGE_REGISTRY_PASS=

# --- AWS ---
AWS_ACCESS_KEY=
AWS_ACCESS_SECRET=

# --- Red Hat subscription ---
SUBSCRIPTION_USERNAME=
SUBSCRIPTION_PASSWORD=

# --- Report Portal ---
RP_URL=
RP_PROJECT=
RP_ROBOT_UUID=
RP_SUPERADMIN_UUID=

# --- Polarion ---
POLARION_USERNAME=
POLARION_PASSWORD=
POLARION_PROJECT=

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- Mac mini ---
MAC_HOSTNAME=
MAC_USERNAME=
MAC_PASSWORD=

# --- Uploader (legacy — pipeline uploads results to https://artifacts.ospqa.com/CI/) ---
# UPLOADER_HOST=https://artifacts.ospqa.com
# UPLOADER_USERNAME=
# UPLOADER_PASSWORD=

# --- GCS Artifact Storage (recommended — free tier, auto-delete after 30 days) ---
# SA key is pulled from Vault (GCS-TOKEN). View results at:
# https://storage.googleapis.com/<bucket>/CI/<version>/<pipelinerun>/index.html
GCS_PROJECT=pipelines-qe
GCS_BUCKET=ospqa-ci-artifacts
