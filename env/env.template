# OPERATOR_ENVIRONMENT=pre-stage
# CATALOG_SOURCE=custom-operators
# KONFLUX_INDEX_IMAGE=quay.io/openshift-pipeline/pipelines-index-4.20:v1.23.0
# TAGS=e2e
# INSTALL_PIPELINES_OPERATOR=true
# INSTALL_SERVERLESS_OPERATOR=false
# TEST_SUITES="release-tests-versions,release-tests-pipelines,release-tests-triggers,release-tests-triggers-tls,release-tests-chains,release-tests-pac,release-tests-pac-github,release-tests-pac-gitlab,release-tests-results,release-tests-metrics,release-tests-rbac,release-tests-addon,release-tests-auto-prune,release-tests-tekton-pruner,release-tests-manual-approval,release-tests-ecosystem,release-tests-ecosystem-s2i"

